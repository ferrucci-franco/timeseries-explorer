  "overrides": {
    "tar": ">=7.5.21"
  },
  "build": {
    "appId": "io.github.ferrucci-franco.timeseries-explorer",
    "productName": "Time Series Explorer",
    "copyright": "Copyright \u00a9 2026 Franco Ferrucci",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "icon": "build/icons/timeseries-explorer-icon.png",
    "directories": {
      "output": "desktop-dist"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "src/data/csv-to-parquet-core.js",
      "src/parsers/**/*",
      "build/icons/**/*",
      "package.json",
      "!node_modules/node-gyp{,/**/*}",
      "!node_modules/**/node-gyp{,/**/*}",
      "!node_modules/cacache{,/**/*}",
      "!node_modules/**/cacache{,/**/*}",
      "!node_modules/make-fetch-happen{,/**/*}",
      "!node_modules/**/make-fetch-happen{,/**/*}",
      "!node_modules/tar{,/**/*}",
      "!node_modules/**/tar{,/**/*}"
    ],
    "asar": true,
    "asarUnpack": [
      "src/data/csv-to-parquet-core.js",
      "src/parsers/**/*",
      "**/*.node"
    ],
    "win": {
      "icon": "build/icons/timeseries-explorer-icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "${productName}-${version}-setup-${arch}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable-${arch}.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
      "category": "public.app-category.utilities"
    },
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
      "category": "Utility",
      "synopsis": "Explore time-series data",
      "description": "Offline desktop application for exploring time-series data.",
      "maintainer": "Franco Ferrucci"
    },
    "deb": {
      "packageCategory": "utils",
      "priority": "optional"
    },
    "appImage": {
      "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
    },
    "npmRebuild": false
  }
}
