# Line endings are decided here rather than by each contributor's core.autocrlf.
# Several scripts/test-*.mjs read a repo file off disk and match multi-line
# patterns against it; written against LF, they either failed outright on a CRLF
# checkout or — worse — silently matched the wrong span and passed. Pinning the
# working tree to LF everywhere means no test has to think about it. Later rules
# win, so the two exceptions below still override this.
* text=auto eol=lf

/.gitattributes text eol=lf
*.sh text eol=lf

# cmd.exe reads a .bat by byte offset when it seeks a label (goto :label,
# call :label), and every one of these launchers uses labels. Checked out with
# LF-only endings — which is what "Download ZIP" or a clone with
# core.autocrlf=false gives — the label seek can land mid-line. Git for Windows
# defaults to autocrlf=true and hid this on the ordinary clone path; this makes
# it true on every path instead of by luck.
*.bat text eol=crlf
